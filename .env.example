# Yahoo mode works without an API key.
# Optional overrides
# YAHOO_BASE_URL=https://query1.finance.yahoo.com
# YAHOO_NEWS_BASE_URL=https://query2.finance.yahoo.com

# Optional volume backfill for candles Yahoo reports with zero volume.
# Accepts a Polygon-compatible /v2/aggs endpoint.
# MASSIVE_API_KEY=your-api-key
# MASSIVE_BASE_URL=https://api.massive.com

# Live poll interval override in milliseconds (minimum 1000).
# Defaults to 15000 during extended trading hours, 120000 outside them.
# LIVE_POLL_MS=15000

# Optional debug logs for backend
# MASSIVE_DEBUG=true
